lemma policy_budget_agreement:
  all-traces
  "∀ sid a b expected actual decision #i #j.
    ((SpecDecision( sid, a, b, expected, decision ) @ #i) ∧
     (ProviderBudget( sid, a, b, actual ) @ #j)) ⇒
    (expected = actual)"
/*
guarded formula characterizing all counter-examples:
"∃ sid a b expected actual decision #i #j.
  (SpecDecision( sid, a, b, expected, decision ) @ #i) ∧
  (ProviderBudget( sid, a, b, actual ) @ #j)
 ∧
  ¬(expected = actual)"
*/
simplify
solve( Scan( sid, 'spec', 'end', best, expected ) ▶₀ #i )
  case Skip_Rule_case_2
  solve( !Decision( expected, decision ) ▶₁ #i )
    case Setup_case_1
    solve( Scan( ~sid, 'provider_eval', 'end', best, actual ) ▶₀ #j )
      case Impl_Select_Better
      solve( Scan( ~sid, 'spec', <<'r0', 'b10'>, 'end'>, 'r70', 'bneg1'
             ) ▶₀ #vr )
        case Spec_Select_Better_case_1
        solve( Scan( ~sid, 'provider_eval', <<'r0', 'b10'>, 'end'>, 'rinit',
                     current
               ) ▶₀ #vr.2 )
          case Impl_Select_Better
          solve( Scan( ~sid, 'spec', <<'r70', 'bneg1'>, <'r0', 'b10'>, 'end'>,
                       'rinit', current
                 ) ▶₀ #vr.3 )
            case Setup
            solve( Scan( ~sid, 'provider_eval',
                         <<'r70', 'bneg1'>, <'r0', 'b10'>, 'end'>, 'rinit', current
                   ) ▶₀ #vr.4 )
              case Provider_Start_case_3
              solve( Scan( ~sid, 'spec', <<'r0', 'b10'>, 'end'>, 'r70', 'bneg1'
                     ) ▶₀ #vr.7 )
                case Spec_Select_Better_case_1
                solve( Scan( ~sid, 'spec', <<'r70', 'bneg1'>, <'r0', 'b10'>, 'end'>,
                             'rinit', current
                       ) ▶₀ #vr.8 )
                  case Setup
                  SOLVED // trace found
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma provider_issue_requires_policy_allow:
  all-traces
  "∀ sid a b otk #i.
    (ProviderIssue( sid, a, b, otk ) @ #i) ⇒
    (∃ budget #j.
      (SpecDecision( sid, a, b, budget, 'allow' ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ sid a b otk #i.
  (ProviderIssue( sid, a, b, otk ) @ #i)
 ∧
  ∀ budget #j.
   (SpecDecision( sid, a, b, budget, 'allow' ) @ #j) ⇒ ¬(#j < #i)"
*/
simplify
solve( ProviderResult( sid, budget ) ▶₀ #i )
  case Provider_Finish_case_1
  solve( !Debit( 'b10', remaining ) ▶₁ #i )
    case Setup
    solve( ProviderUnusedOTK( ~sid, 'A', otk ) ▶₂ #i )
      case Setup
      solve( Scan( ~sid, 'provider_eval', <<'r0', 'b10'>, 'end'>, 'rinit',
                   current
             ) ▶₀ #vr.1 )
        case Impl_Select_Better
        solve( Scan( ~sid, 'provider_eval',
                     <<'r70', 'bneg1'>, <'r0', 'b10'>, 'end'>, 'rinit', current
               ) ▶₀ #vr.3 )
          case Provider_Start_case_3
          solve( Scan( ~sid, 'spec', <<'r0', 'b10'>, 'end'>, 'r70', 'bneg1'
                 ) ▶₀ #vr.6 )
            case Spec_Select_Better_case_1
            solve( Scan( ~sid, 'spec', <<'r70', 'bneg1'>, <'r0', 'b10'>, 'end'>,
                         'rinit', current
                   ) ▶₀ #vr.7 )
              case Setup
              SOLVED // trace found
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma token_issue_requires_policy_allow:
  all-traces
  "∀ sid a b tok #i.
    (TokenIssue( sid, a, b, tok ) @ #i) ⇒
    (∃ budget #j.
      (SpecDecision( sid, a, b, budget, 'allow' ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ sid a b tok #i.
  (TokenIssue( sid, a, b, tok ) @ #i)
 ∧
  ∀ budget #j.
   (SpecDecision( sid, a, b, budget, 'allow' ) @ #j) ⇒ ¬(#j < #i)"
*/
simplify
solve( ReceiverResult( sid, budget ) ▶₀ #i )
  case Receiver_Finish_case_1
  solve( !ReceiverAllows( 'b10' ) ▶₁ #i )
    case Setup
    solve( PendingToken( ~sid, otk, pac ) ▶₂ #i )
      case Receiver_Start_case_1
      solve( !Registered( ~sid, 'B', 'g'^~bsk ) ▶₃ #i )
        case Setup
        solve( ReceiverUnusedOTK( ~sid, 'A', 'g'^~osk, osk.1 ) ▶₄ #i )
          case Setup
          solve( Scan( ~sid, 'receiver', <<'r0', 'b10'>, 'end'>, 'rinit', current
                 ) ▶₀ #vr.1 )
            case Impl_Select_Better
            solve( Scan( ~sid, 'provider_eval', <<'r0', 'b10'>, 'end'>, 'rinit',
                         current
                   ) ▶₀ #vr.7 )
              case Impl_Select_Better
              solve( Scan( ~sid, 'receiver', <<'r70', 'bneg1'>, <'r0', 'b10'>, 'end'>,
                           'rinit', current
                     ) ▶₀ #vr.8 )
                case Receiver_Start
                solve( Scan( ~sid, 'provider_eval',
                             <<'r70', 'bneg1'>, <'r0', 'b10'>, 'end'>, 'rinit', current
                       ) ▶₀ #vr.9 )
                  case Provider_Start_case_3
                  solve( Scan( ~sid, 'spec', <<'r0', 'b10'>, 'end'>, 'r70', 'bneg1'
                         ) ▶₀ #vr.12 )
                    case Spec_Select_Better_case_1
                    solve( Scan( ~sid, 'spec', <<'r70', 'bneg1'>, <'r0', 'b10'>, 'end'>,
                                 'rinit', current
                           ) ▶₀ #vr.13 )
                      case Setup
                      SOLVED // trace found
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma chat_requires_policy_allow:
  all-traces
  "∀ sid a b tok msg #i.
    (ChatAccept( sid, a, b, tok, msg ) @ #i) ⇒
    (∃ budget #j.
      (SpecDecision( sid, a, b, budget, 'allow' ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ sid a b tok msg #i.
  (ChatAccept( sid, a, b, tok, msg ) @ #i)
 ∧
  ∀ budget #j.
   (SpecDecision( sid, a, b, budget, 'allow' ) @ #j) ⇒ ¬(#j < #i)"
*/
simplify
solve( TLSChat( sid, 'B', 'A', tok, pac, msg ) ▶₀ #i )
  case Sender_Send_Chat_case_07
  solve( !Registered( ~sid, 'B', 'g'^~bsk ) ▶₁ #i )
    case Setup
    solve( ActiveToken( ~sid, 'A', 'B',
                        senc(<'ACT', ~token, 'g'^~bsk>,
                             h(<'access-control-shdk-exchange', 'g'^(~bsk*~osk)>)),
                        'g'^~bsk
           ) ▶₂ #i )
      case Receiver_Issue_Token
      solve( Scan( ~sid, 'receiver', <<'r0', 'b10'>, 'end'>, 'rinit', current
             ) ▶₀ #vr.9 )
        case Impl_Select_Better
        solve( Scan( ~sid, 'provider_eval', <<'r0', 'b10'>, 'end'>, 'rinit',
                     current
               ) ▶₀ #vr.10 )
          case Impl_Select_Better
          solve( Scan( ~sid, 'receiver', <<'r70', 'bneg1'>, <'r0', 'b10'>, 'end'>,
                       'rinit', current
                 ) ▶₀ #vr.11 )
            case Receiver_Start
            solve( Scan( ~sid, 'provider_eval',
                         <<'r70', 'bneg1'>, <'r0', 'b10'>, 'end'>, 'rinit', current
                   ) ▶₀ #vr.12 )
              case Provider_Start_case_3
              solve( Scan( ~sid, 'spec', <<'r0', 'b10'>, 'end'>, 'r70', 'bneg1'
                     ) ▶₀ #vr.15 )
                case Spec_Select_Better_case_1
                solve( Scan( ~sid, 'spec', <<'r70', 'bneg1'>, <'r0', 'b10'>, 'end'>,
                             'rinit', current
                       ) ▶₀ #vr.16 )
                  case Setup
                  SOLVED // trace found
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma chat_requires_token_issue:
  all-traces
