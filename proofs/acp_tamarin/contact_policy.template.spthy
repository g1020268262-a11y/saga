theory @THEORY@
begin

builtins: diffie-hellman, symmetric-encryption, hashing

/* Fixed, ordered, concrete rulebook; matching rules retain their order.
   The generator supplies rank comparisons, not precomputed decisions.
   Registration and authenticated TLS follow the existing OTK model. */
restriction UniqueSetup:
  "All #i #j. Setup() @i & Setup() @j ==> #i = #j"

rule Setup:
  [ Fr(~sid), Fr(~bsk), Fr(~osk) ]
  --[ Setup() ]->
  [ !Client(~sid,'B',~bsk), !Registered(~sid,'B','g'^~bsk),
    ProviderUnusedOTK(~sid,'A','g'^~osk),
    ReceiverUnusedOTK(~sid,'A','g'^~osk,~osk),
    !Rules(~sid,@RULES@),
    Scan0(~sid,'spec','rinit','b0'),
    !SpecMode('spec'), !ImplMode('provider_eval'), !ImplMode('receiver'),
    @FACTS@,
    Out('g'^~bsk) ]

/* Both evaluator branches traverse the same ordered matching-rule list.
   The spec updates the best rank; the buggy implementation only updates
   the budget.  Comparisons use the concrete scores of the source matcher. */
/* Scan_i is exactly Scan with the i-th suffix of the fixed rulebook.
   The generator unfolds positions only, not decisions or budget results. */
@SCAN_RULES@

rule Spec_Finish:
  [ @SCAN_END@(sid,'spec',best,budget), !Decision(budget,decision) ]
  --[ SpecDecision(sid,'A','B',budget,decision) ]->
  [ AccessReady(sid) ]

rule Provider_Start:
  [ AccessReady(sid), !Rules(sid,rules), !Registered(sid,'B',pac) ]
  --[ AccessRequested(sid,'A','B') ]->
  [ Scan0(sid,'provider_eval','rinit','b0') ]

rule Provider_Finish:
  [ @SCAN_END@(sid,'provider_eval',best,budget) ]
  --[ ProviderBudget(sid,'A','B',budget) ]->
  [ ProviderResult(sid,budget) ]

rule Provider_Release:
  [ ProviderResult(sid,budget), !Debit(budget,remaining),
    ProviderUnusedOTK(sid,'A',otk) ]
  --[ ProviderIssue(sid,'A','B',otk),
      ProviderDebit(sid,'A','B',budget,remaining) ]->
  [ TLSOTKResponse(sid,'Provider','B','A',otk),
    ProviderRemaining(sid,'A','B',remaining) ]

rule Provider_Reject:
  [ ProviderResult(sid,budget), !Decision(budget,'deny') ]
  --[ ProviderReject(sid,'A','B',budget) ]->
  [ ]

rule Sender_Request_Token:
  [ TLSOTKResponse(sid,'Provider','B','A',otk), !Client(sid,'B',sk) ]
  --[ TokenRequest(sid,'A','B',otk) ]->
  [ TLSTokenRequest(sid,'B','A',otk,'g'^sk),
    WaitingForToken(sid,'A','B',otk,sk) ]

rule Receiver_Start:
  [ TLSTokenRequest(sid,'B','A',otk,pac),
    !Registered(sid,'B',pac), !Rules(sid,rules) ]
  --[ ReceiverCheckStarted(sid,'A','B') ]->
  [ PendingToken(sid,otk,pac), Scan0(sid,'receiver','rinit','b0') ]

rule Receiver_Finish:
  [ @SCAN_END@(sid,'receiver',best,budget) ]
  --[ ReceiverBudget(sid,'A','B',budget) ]->
  [ ReceiverResult(sid,budget) ]

/* Receiver rejects negative values, unlike Provider which also rejects zero. */
rule Receiver_Reject:
  [ ReceiverResult(sid,budget), PendingToken(sid,otk,pac),
    !ReceiverDenies(budget) ]
  --[ ReceiverReject(sid,'A','B',budget) ]->
  [ ]

rule Receiver_Issue_Token:
  let key = h(<'access-control-shdk-exchange',pac^osk>)
      cipher = senc(<'ACT',~token,pac>,key)
  in
  [ ReceiverResult(sid,budget), !ReceiverAllows(budget),
    PendingToken(sid,otk,pac), !Registered(sid,'B',pac),
    ReceiverUnusedOTK(sid,'A',otk,osk), Fr(~token) ]
  --[ TokenIssue(sid,'A','B',cipher) ]->
  [ TLSTokenResponse(sid,'A','B',cipher),
    ActiveToken(sid,'A','B',cipher,pac) ]

rule Sender_Decrypt_Token:
  let pac = 'g'^sk
      key = h(<'access-control-shdk-exchange',otk^sk>)
      cipher = senc(<'ACT',token,pac>,key)
  in
  [ WaitingForToken(sid,'A','B',otk,sk),
    TLSTokenResponse(sid,'A','B',cipher) ]
  --[ TokenReceive(sid,'A','B',cipher) ]->
  [ ReadyForChat(sid,'A','B',cipher,pac) ]

rule Sender_Send_Chat:
  [ ReadyForChat(sid,'A','B',cipher,pac), Fr(~msg) ]
  --[ ChatSend(sid,'A','B',cipher,~msg) ]->
  [ TLSChat(sid,'B','A',cipher,pac,~msg) ]

rule Receiver_Accept_Chat:
  [ TLSChat(sid,'B','A',cipher,pac,msg),
    !Registered(sid,'B',pac), ActiveToken(sid,'A','B',cipher,pac) ]
  --[ ChatAccept(sid,'A','B',cipher,msg) ]->
  [ ]

/* Sanity and source-observation alignment; existence prevents a vacuous
   proof of the evaluator result. Expected values occur only in lemmas. */
lemma evaluation_reachable:
  exists-trace
  "Ex sid #i #j. SpecDecision(sid,'A','B',@SPEC@,@SPEC_DEC@) @i
    & ProviderBudget(sid,'A','B',@OBS@) @j & i < j"

lemma spec_matches_reference:
  "All sid a b budget decision #i. SpecDecision(sid,a,b,budget,decision) @i
    ==> (budget = @SPEC@ & decision = @SPEC_DEC@)"

lemma provider_matches_observation:
  "All sid a b budget #i. ProviderBudget(sid,a,b,budget) @i
    ==> budget = @OBS@"

lemma receiver_matches_observation:
  "All sid a b budget #i. ReceiverBudget(sid,a,b,budget) @i
    ==> budget = @OBS@"

lemma policy_budget_agreement:
  "All sid a b expected actual decision #i #j.
    SpecDecision(sid,a,b,expected,decision) @i
    & ProviderBudget(sid,a,b,actual) @j ==> expected = actual"

lemma provider_issue_requires_policy_allow:
  "All sid a b otk #i. ProviderIssue(sid,a,b,otk) @i
    ==> (Ex budget #j. SpecDecision(sid,a,b,budget,'allow') @j & j < i)"

lemma token_issue_requires_policy_allow:
  "All sid a b tok #i. TokenIssue(sid,a,b,tok) @i
    ==> (Ex budget #j. SpecDecision(sid,a,b,budget,'allow') @j & j < i)"

lemma chat_requires_policy_allow:
  "All sid a b tok msg #i. ChatAccept(sid,a,b,tok,msg) @i
    ==> (Ex budget #j. SpecDecision(sid,a,b,budget,'allow') @j & j < i)"

/* Direct counterpart to the original ProVerif correspondence query. */
lemma chat_requires_token_issue:
  "All sid a b tok msg #i. ChatAccept(sid,a,b,tok,msg) @i
    ==> (Ex #j. TokenIssue(sid,a,b,tok) @j & j < i)"

lemma chat_requires_decryption:
  "All sid a b tok msg #i. ChatAccept(sid,a,b,tok,msg) @i
    ==> (Ex #j #k. TokenIssue(sid,a,b,tok) @j
      & TokenReceive(sid,a,b,tok) @k & j < k & k < i)"

lemma provider_rejection_reachable:
  exists-trace
  "Ex sid a b budget #i. ProviderReject(sid,a,b,budget) @i"

lemma receiver_evaluation_reachable:
  exists-trace
  "Ex sid #i. ReceiverBudget(sid,'A','B',@OBS@) @i"

lemma provider_release_reachable:
  exists-trace
  "Ex sid a b otk #i. ProviderIssue(sid,a,b,otk) @i"

lemma token_issue_reachable:
  exists-trace
  "Ex sid a b tok #i. TokenIssue(sid,a,b,tok) @i"

/* Direct counterpart to the old reachability query (opposite truth polarity). */
lemma chat_accept_reachable:
  exists-trace
  "Ex sid a b tok msg #i. ChatAccept(sid,a,b,tok,msg) @i"

lemma denied_chat_reachable:
  exists-trace
  "Ex sid a b budget tok msg #i #j.
    SpecDecision(sid,a,b,budget,'deny') @i
    & ChatAccept(sid,a,b,tok,msg) @j & i < j"

end
