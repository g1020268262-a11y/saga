                  qed
                qed
              qed
            next
              case Sender_Requests_Access_case_2
              solve( !Registered( 'C', pac ) ▶₁ #j )
                case Setup
                by solve( !ProviderAllows( 'A', 'C' ) ▶₂ #j )
              qed
            qed
          qed
        qed
      qed
    qed
  next
    case Sender_Requests_Access_case_2
    solve( !Registered( 'C', pac ) ▶₁ #i )
      case Setup
      by solve( !ProviderAllows( 'A', 'C' ) ▶₂ #i )
    qed
  qed
next
  case case_2
  solve( TLSAccessRequest( s1, 'Provider', a, request ) ▶₀ #i )
    case Sender_Requests_Access_case_1
    solve( !Registered( 'B', pac ) ▶₁ #i )
      case Setup
      solve( !ProviderAllows( 'A', 'B' ) ▶₂ #i )
        case Setup
        solve( ProviderCredit( 'A', 'B' ) ▶₃ #i )
          case Setup
          solve( ProviderUnusedOTK( 'A', k ) ▶₄ #i )
            case Setup_case_1
            solve( TLSAccessRequest( s2, 'Provider', 'A', request.1 ) ▶₀ #j )
              case Sender_Requests_Access_case_1
              solve( !Registered( 'B', pac ) ▶₁ #j )
                case Setup
                solve( !ProviderAllows( 'A', 'B' ) ▶₂ #j )
                  case Setup
                  solve( ProviderCredit( 'A', 'B' ) ▶₃ #j )
                    case Setup
                    by contradiction /* cyclic */
                  qed
                qed
              qed
            next
              case Sender_Requests_Access_case_2
              solve( !Registered( 'C', pac ) ▶₁ #j )
                case Setup
                by solve( !ProviderAllows( 'A', 'C' ) ▶₂ #j )
              qed
            qed
          next
            case Setup_case_2
            solve( TLSAccessRequest( s2, 'Provider', 'A', request.1 ) ▶₀ #j )
              case Sender_Requests_Access_case_1
              solve( !Registered( 'B', pac ) ▶₁ #j )
                case Setup
                solve( !ProviderAllows( 'A', 'B' ) ▶₂ #j )
                  case Setup
                  solve( ProviderCredit( 'A', 'B' ) ▶₃ #j )
                    case Setup
                    by contradiction /* cyclic */
                  qed
                qed
              qed
            next
              case Sender_Requests_Access_case_2
              solve( !Registered( 'C', pac ) ▶₁ #j )
                case Setup
                by solve( !ProviderAllows( 'A', 'C' ) ▶₂ #j )
              qed
            qed
          qed
        qed
      qed
    qed
  next
    case Sender_Requests_Access_case_2
    solve( !Registered( 'C', pac ) ▶₁ #i )
      case Setup
      by solve( !ProviderAllows( 'A', 'C' ) ▶₂ #i )
    qed
  qed
qed

lemma receiver_consumes_each_OTK_once:
  all-traces
  "∀ a s1 s2 k t1 t2 p1 p2 #i #j.
    ((ReceiverTokenIssued( a, s1, k, t1, p1 ) @ #i) ∧
     (ReceiverTokenIssued( a, s2, k, t2, p2 ) @ #j)) ⇒
    (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ a s1 s2 k t1 t2 p1 p2 #i #j.
  (ReceiverTokenIssued( a, s1, k, t1, p1 ) @ #i) ∧
  (ReceiverTokenIssued( a, s2, k, t2, p2 ) @ #j)
 ∧
  ¬(#i = #j)"
*/
simplify
solve( (#i < #j)  ∥ (#j < #i) )
  case case_1
  solve( TLSTokenRequest( s1, a, sid, k, p1 ) ▶₀ #i )
    case Sender_Requests_Token_case_1
    solve( !Registered( 'B', 'g'^~bsk ) ▶₁ #i )
      case Setup
      solve( !LocalAllows( 'A', 'B' ) ▶₂ #i )
        case Setup
        solve( ReceiverUnusedOTK( 'A', 'g'^~otk1, otk_secret ) ▶₃ #i )
          case Setup
          solve( TLSTokenRequest( s2, 'A', sid.1, 'g'^~otk1, p2 ) ▶₀ #j )
            case Sender_Requests_Token_case_1
            solve( !Registered( 'B', 'g'^~bsk ) ▶₁ #j )
              case Setup
              solve( !LocalAllows( 'A', 'B' ) ▶₂ #j )
                case Setup
                solve( ReceiverUnusedOTK( 'A', 'g'^~otk1, otk_secret ) ▶₃ #j )
                  case Setup
                  by contradiction /* cyclic */
                qed
              qed
            qed
          next
            case Sender_Requests_Token_case_2
            solve( !Registered( 'C', 'g'^~csk ) ▶₁ #j )
              case Setup
              by solve( !LocalAllows( 'A', 'C' ) ▶₂ #j )
            qed
          qed
        qed
      qed
    qed
  next
    case Sender_Requests_Token_case_2
    solve( !Registered( 'B', 'g'^~bsk ) ▶₁ #i )
      case Setup
      solve( !LocalAllows( 'A', 'B' ) ▶₂ #i )
        case Setup
        solve( ReceiverUnusedOTK( 'A', 'g'^~otk2, otk_secret ) ▶₃ #i )
          case Setup
          solve( TLSTokenRequest( s2, 'A', sid.1, 'g'^~otk2, p2 ) ▶₀ #j )
            case Sender_Requests_Token_case_1
            solve( !Registered( 'B', 'g'^~bsk ) ▶₁ #j )
              case Setup
              solve( !LocalAllows( 'A', 'B' ) ▶₂ #j )
                case Setup
                solve( ReceiverUnusedOTK( 'A', 'g'^~otk2, otk_secret ) ▶₃ #j )
                  case Setup
                  by contradiction /* cyclic */
                qed
              qed
            qed
          next
            case Sender_Requests_Token_case_2
            solve( !Registered( 'C', 'g'^~csk ) ▶₁ #j )
              case Setup
              by solve( !LocalAllows( 'A', 'C' ) ▶₂ #j )
            qed
          qed
        qed
      qed
    qed
  next
    case Sender_Requests_Token_case_3
    solve( !Registered( 'C', 'g'^~csk ) ▶₁ #i )
      case Setup
      by solve( !LocalAllows( 'A', 'C' ) ▶₂ #i )
    qed
  next
    case Sender_Requests_Token_case_4
    solve( !Registered( 'C', 'g'^~csk ) ▶₁ #i )
      case Setup
      by solve( !LocalAllows( 'A', 'C' ) ▶₂ #i )
    qed
  qed
next
  case case_2
  solve( TLSTokenRequest( s1, a, sid, k, p1 ) ▶₀ #i )
    case Sender_Requests_Token_case_1
    solve( !Registered( 'B', 'g'^~bsk ) ▶₁ #i )
      case Setup
      solve( !LocalAllows( 'A', 'B' ) ▶₂ #i )
        case Setup
        solve( ReceiverUnusedOTK( 'A', 'g'^~otk1, otk_secret ) ▶₃ #i )
          case Setup
          solve( TLSTokenRequest( s2, 'A', sid.1, 'g'^~otk1, p2 ) ▶₀ #j )
            case Sender_Requests_Token_case_1
            solve( !Registered( 'B', 'g'^~bsk ) ▶₁ #j )
              case Setup
              solve( !LocalAllows( 'A', 'B' ) ▶₂ #j )
                case Setup
                solve( ReceiverUnusedOTK( 'A', 'g'^~otk1, otk_secret ) ▶₃ #j )
                  case Setup
                  by contradiction /* cyclic */
                qed
              qed
            qed
          next
